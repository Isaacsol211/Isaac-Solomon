		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"wrangler": "^4.127.1"
	},
	"dependencies": {
		"@fontsource-variable/space-grotesk": "^5.2.10",
		"@fontsource/instrument-serif": "^5.2.8",
