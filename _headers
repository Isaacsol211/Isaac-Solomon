# Applies to every response.
#
# Deliberately NO Cache-Control here. Cloudflare MERGES same-name headers from
# every matching rule rather than letting the most specific one win, so a global
# Cache-Control is concatenated onto each asset rule below and yields
# contradictory directives like "no-store, ..., public, max-age=604800".
# HTML pages get their own no-store rule, emitted per page by
# scripts/generate-markdown.mjs alongside their Link and Vary headers.
/*
  # RFC 8288 — point agents at the site index and the MCP endpoint.
  # generate-markdown.mjs appends a per-page rel="alternate" for each .md twin;
  # Cloudflare merges same-name Link headers into one comma-separated value.
  Link: </llms.txt>; rel="describedby"; type="text/plain", </mcp>; rel="service-desc"; type="application/json"
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Hashed JS/CSS/fonts — immutable forever (the hash in the filename is the cache key).
# One rule only: a second matching rule would merge into a duplicated directive.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

# Un-hashed images — 1 week, revalidate in the background.
/photos/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/projects/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Case-study images. Scoped per article directory rather than /writing/* — that
# wildcard also matches the article pages themselves (/writing/saut), which would
# merge an image cache policy onto an HTML page.
/writing/godrej/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/writing/keus/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/writing/novarock/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/writing/tomorrow-makers/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Agent discovery documents
/.well-known/api-catalog
  Content-Type: application/linkset+json

/.well-known/ai-catalog.json
  Access-Control-Allow-Origin: *

/.well-known/mcp/server-card.json
  Access-Control-Allow-Origin: *

# Storybook illustrations — un-hashed, same policy as the other images.
/story/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# The beta host is a preview of the next design: keep it out of search results.
# Matches only this hostname, so production is unaffected.
https://beta.isaacsolomon.dev/*
  X-Robots-Tag: noindex, nofollow
