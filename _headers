# HTML pages — never cache, always fresh from origin
/*
  Cache-Control: no-store, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Hashed JS/CSS chunks — immutable forever (hash in filename guarantees freshness)
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts bundled by Vite — same hash strategy
/_app/immutable/assets/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Static images (un-hashed) — 1 week, revalidate
/photos/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/projects/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/writing/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# WebP images in writing section
/writing/novarock/*.webp
  Cache-Control: public, max-age=31536000, immutable
